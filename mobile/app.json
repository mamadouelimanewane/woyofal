{
  "expo": {
    "name": "KURAÑ Agent",
    "slug": "kuran-agent",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "sn.processingenierie.kuran"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "sn.processingenierie.kuran",
      "permissions": [
        "android.permission.INTERNET"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "KURAÑ Agent",
      "shortName": "KURAÑ",
      "lang": "fr",
      "themeColor": "#0f766e",
      "backgroundColor": "#f1f5f9"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "KURAÑ utilise l'appareil photo pour lire les tickets Woyofal et les index des compteurs.",
          "photosPermission": "KURAÑ accède aux photos pour lire un ticket enregistré."
        }
      ]
    ],
    "scheme": "kuran",
    "splash": {
      "backgroundColor": "#0f172a",
      "resizeMode": "contain",
      "image": "./assets/splash-icon.png"
    },
    "extra": {
      "eas": {}
    }
  }
}