# Sans DATABASE_URL : PGlite local (.pglite/), aucune installation requise.
DATABASE_URL=
JWT_SECRET=changer-en-production-32-caracteres-minimum
# SMS (OTP + relances). Sans fournisseur, l'OTP est renvoyé dans la réponse (dev / démo).
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=KURAN
# WhatsApp Business Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Cron Vercel
CRON_SECRET=
# Origine publique (liens de quittance et de paiement envoyés aux occupants)
APP_URL=https://woyofal.vercel.app
# Paiement en ligne. Sans clés : mode simulation (page /api/public/paiements/:id/simulateur).
# PAIEMENT_SIMULATION=1 force la simulation même avec des clés.
WAVE_API_KEY=
WAVE_WEBHOOK_SECRET=
OM_CLIENT_ID=
OM_CLIENT_SECRET=
OM_MERCHANT_KEY=
OM_ENV=dev
# E-mail (alertes, rapport mensuel) via Resend
RESEND_API_KEY=
EMAIL_FROM=KURAÑ <kuran@votre-domaine.sn>
